<Window x:Class="Orva.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:Orva.Controls"
        Title="ORVA — Pharmacy Billing &amp; Inventory"
        Width="1360" Height="760" MinWidth="1000" MinHeight="560"
        WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="{StaticResource Paper}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <!-- ZERO-AIRSPACE 2-COLUMN PUSH LAYOUT: NavDrawer sits in Column 0, WebView2/Content sits in Column 1 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- COLLAPSIBLE SPRING HAMBURGER NAVIGATION DRAWER (NEVER OVERLAPS WEBVIEW2 HWND) -->
        <Border x:Name="NavDrawer"
                Grid.Column="0"
                Width="0"
                ClipToBounds="True"
                Background="#0F0F0F"
                BorderBrush="#262626"
                BorderThickness="0,0,1,0">
            <Grid Width="272" Margin="18,20,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Width="32" Height="32"
                            Background="#1A1A1A" Foreground="#FAFAFA"
                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Top"
                            ToolTip="Close menu (Esc)"
                            Click="CloseDrawer_Click">
                        <Path Data="{StaticResource IconClose}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="#FAFAFA" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="ORVA" FontFamily="{StaticResource UiHeadingFont}" FontSize="27" Foreground="#FAFAFA" />
                        <TextBlock Text="PHARMACY WORKSPACE" FontFamily="{StaticResource UiMonoFont}" FontSize="9" Foreground="#8A8A8A" Margin="1,2,0,0" />
                        <Border x:Name="DrawerAccentBar" Height="2" Width="44" Background="#8B7CFF" HorizontalAlignment="Left" Margin="0,12,0,0" />
                        <TextBlock x:Name="ShopNameText" Text="Medical store" Foreground="#FAFAFA" FontSize="13" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="2" Text="{DynamicResource MenuLabel}" FontFamily="{StaticResource UiMonoFont}" FontSize="9.5" Foreground="#7A7A7A" Margin="6,0,0,8" />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="NavHomeBtn" Tag="{StaticResource IconHome}" Content="{DynamicResource NavHome}" Style="{StaticResource NavIconButton}" Click="Home_Click" />
                        <Button x:Name="NavBillingBtn" Tag="{StaticResource IconBilling}" Content="{DynamicResource NavBilling}" Style="{StaticResource NavIconButton}" Click="Billing_Click" />
                        <Button x:Name="NavInventoryBtn" Tag="{StaticResource IconInventory}" Content="{DynamicResource NavInventory}" Style="{StaticResource NavIconButton}" Click="Inventory_Click" />
                        <Button x:Name="NavInvoicesBtn" Tag="{StaticResource IconInvoices}" Content="{DynamicResource NavInvoices}" Style="{StaticResource NavIconButton}" Click="Invoices_Click" />
                        <Button x:Name="NavReturnsBtn" Tag="{StaticResource IconReturns}" Content="{DynamicResource NavReturns}" Style="{StaticResource NavIconButton}" Click="Returns_Click" />
                        <Button x:Name="NavRecordsBtn" Tag="{StaticResource IconRecords}" Content="{DynamicResource NavRecords}" Style="{StaticResource NavIconButton}" Click="Records_Click" />
                        <Button x:Name="NavSettingsBtn" Tag="{StaticResource IconSettings}" Content="{DynamicResource NavSettings}" Style="{StaticResource NavIconButton}" Click="Settings_Click" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="4">
                    <Border Height="1" Background="#262626" Margin="0,8,0,10" />
                    <Button x:Name="NavSubscriptionBtn" Tag="{StaticResource IconSubscription}" Content="{DynamicResource NavSubscription}" Style="{StaticResource NavIconButton}" Click="Subscription_Click" />
                    <Button x:Name="NavAboutBtn" Tag="{StaticResource IconAbout}" Content="{DynamicResource NavAboutUs}" Style="{StaticResource NavIconButton}" Click="AboutUs_Click" />
                    <TextBlock Text="{DynamicResource DisplayLanguage}" FontFamily="{StaticResource UiMonoFont}" FontSize="9" Foreground="#7A7A7A" Margin="6,12,0,6" />
                    <Grid Background="#1C1C1C" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button x:Name="EnglishButton" Grid.Column="0" Content="English" Background="#FAFAFA" Foreground="#0A0A0A" BorderThickness="0" Padding="9,8" FontWeight="SemiBold" Click="English_Click" />
                        <Button x:Name="BengaliButton" Grid.Column="1" Content="বাংলা" Background="Transparent" Foreground="#FAFAFA" BorderThickness="0" Padding="9,8" FontWeight="SemiBold" Click="Bengali_Click" />
                    </Grid>
                    <TextBlock Text="RINDLE WORKS  ·  ORVA 4.0" FontFamily="{StaticResource UiMonoFont}" FontSize="9" Foreground="#7A7A7A" Margin="6,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE COLUMN (ADAPTIVE TOP BAR + PAGE HOST) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TopBarBorder" Grid.Row="0" Background="#0A0A0A" BorderBrush="#262626" BorderThickness="0,0,0,1" Padding="18,10">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="HamburgerButton"
                                Style="{StaticResource HamburgerButtonStyle}"
                                ToolTip="Toggle navigation menu"
                                Click="Hamburger_Click"
                                Margin="0,0,14,0">
                            <StackPanel Width="18" VerticalAlignment="Center">
                                <Border x:Name="HamLine1" Height="1.8" Background="#FAFAFA" Margin="0,0,0,4" />
                                <Border x:Name="HamLine2" Height="1.8" Background="#FAFAFA" Margin="0,0,0,4" />
                                <Border x:Name="HamLine3" Height="1.8" Width="12" HorizontalAlignment="Left" Background="{StaticResource Vermilion}" />
                            </StackPanel>
                        </Button>

                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Click="Home_Click" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TopBrandText" Text="ORVA" FontFamily="{StaticResource UiHeadingFont}" FontSize="20" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                <Border x:Name="TopBrandDot" Width="5" Height="5" CornerRadius="3" Background="#8B7CFF" VerticalAlignment="Top" Margin="3,5,0,0" />
                            </StackPanel>
                        </Button>

                        <Border x:Name="TopDivider" Width="1" Height="22" Background="#262626" Margin="0,0,16,0" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageEyebrow" Text="ORVA  /  HOME" Style="{StaticResource MetadataText}" FontSize="9.5" Foreground="#8A8A8A" />
                            <TextBlock x:Name="PageTitle" Text="Home" FontFamily="{StaticResource UiBodyFont}" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentDateText" Text="19 NOV 2026" Style="{StaticResource MetadataText}" FontSize="10" Foreground="#8A8A8A" HorizontalAlignment="Right" />
                            <TextBlock Text="READY · SAVED ON THIS PC" FontFamily="{StaticResource UiMonoFont}" FontSize="8.5" Foreground="{StaticResource Success}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="PageHostContainer" Grid.Row="1" Margin="0">
                <ContentControl x:Name="PageHost" />
            </Grid>
        </Grid>
    </Grid>
</Window>