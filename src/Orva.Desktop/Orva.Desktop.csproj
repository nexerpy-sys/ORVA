<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Orva</RootNamespace>
    <AssemblyName>ORVA</AssemblyName>
    <ApplicationIcon>Assets\orva.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>4.0.0</Version>
    <Company>Rindle Works</Company>
    <Product>ORVA Pharmacy Billing &amp; Inventory</Product>
    <Description>Offline-first Windows pharmacy billing and inventory software.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Printing" />
    <Reference Include="ReachFramework" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\orva.ico" Condition="Exists('Assets\orva.ico')" />
    <Resource Include="Assets\apothecary_frieze.jpg" Condition="Exists('Assets\apothecary_frieze.jpg')" />
    <Resource Include="Assets\apothecary_frieze_bw.jpg" Condition="Exists('Assets\apothecary_frieze_bw.jpg')" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <EmbeddedResource Include="Assets\apothecary_frieze_bw.jpg"
                      LogicalName="Orva.Assets.apothecary_frieze_bw.jpg"
                      Condition="Exists('Assets\apothecary_frieze_bw.jpg')" />
    <EmbeddedResource Include="Assets\apothecary_frieze.jpg"
                      LogicalName="Orva.Assets.apothecary_frieze.jpg"
                      Condition="Exists('Assets\apothecary_frieze.jpg')" />
    <EmbeddedResource Include="Infrastructure\Database\001_InitialSchema.sql"
                      LogicalName="Orva.Infrastructure.Database.001_InitialSchema.sql" />
    <EmbeddedResource Include="Infrastructure\Database\002_BillingTaxConfig.sql"
                      LogicalName="Orva.Infrastructure.Database.002_BillingTaxConfig.sql" />
    <EmbeddedResource Include="Infrastructure\Database\003_PerformanceIndexes.sql"
                      LogicalName="Orva.Infrastructure.Database.003_PerformanceIndexes.sql" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web" />
  </ItemGroup>
</Project>