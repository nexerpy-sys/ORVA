<UserControl x:Class="Orva.Views.SalesReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="clr-namespace:Orva.Controls"
             Background="Transparent"
             FontFamily="{StaticResource UiBodyFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- EDITORIAL ARCHIVAL MASTHEAD -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                <fx:RegistrationMark DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="04" FontFamily="{StaticResource UiMonoFont}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource FederalBlue}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Width="1" Height="12" Background="{StaticResource Rule}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource NavReturns}" Style="{StaticResource MetadataText}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
                <Border Height="1.5" Background="{StaticResource Ink}" Opacity="0.85" />
                <Border Height="2" Width="64" HorizontalAlignment="Left" Background="{StaticResource FederalBlue}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="210" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- LEFT: Find Original Invoice -->
        <Border Grid.Column="0" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource RetFindInvoice}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" x:Name="InvoiceSearchBox" Margin="0,0,0,10" TextChanged="InvoiceSearchBox_TextChanged" />
                <ListBox Grid.Row="2" x:Name="InvoiceListBox" BorderThickness="0" Background="Transparent" SelectionChanged="InvoiceListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" Padding="4,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding InvoiceNumber}" FontWeight="SemiBold" Foreground="{StaticResource Teal}" />
                                    <TextBlock Text="{Binding CustomerName}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                                    <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- RIGHT: Return Items & Finalize -->
        <Border Grid.Column="2" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="SelectedInvoiceHeader" Text="{DynamicResource RetSelectPrompt}" Style="{StaticResource SectionHeading}" FontSize="16" />
                    <TextBlock Text="{DynamicResource RetQuarantineNotice}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="ReturnLinesGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,14">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="MEDICINE" Binding="{Binding MedicineName}" IsReadOnly="True" Width="2*" MinWidth="140" />
                        <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNumber}" IsReadOnly="True" Width="0.9*" MinWidth="80" />
                        <DataGridTextColumn Header="RETURNABLE" Binding="{Binding RemainingText}" IsReadOnly="True" Width="0.9*" MinWidth="85" />
                        <DataGridTextColumn Header="RETURN QTY" Binding="{Binding ReturnQtyText, UpdateSourceTrigger=PropertyChanged}" Width="0.9*" MinWidth="85" />
                        <DataGridComboBoxColumn Header="DISPOSITION" SelectedItemBinding="{Binding Disposition, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" MinWidth="115">
                            <DataGridComboBoxColumn.ItemsSource>
                                <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                    <sys:String>QUARANTINE</sys:String>
                                    <sys:String>DAMAGED</sys:String>
                                    <sys:String>EXPIRED</sys:String>
                                    <sys:String>RESTOCK</sys:String>
                                </x:Array>
                            </DataGridComboBoxColumn.ItemsSource>
                        </DataGridComboBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource RetReasonLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ReasonBox" MaxLength="240" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource RetRefundMethod}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="RefundMethodBox" SelectedIndex="0">
                                <ComboBoxItem Content="Cash" Tag="CASH" />
                                <ComboBoxItem Content="UPI" Tag="UPI" />
                                <ComboBoxItem Content="Debit Card" Tag="DEBIT_CARD" />
                                <ComboBoxItem Content="Credit Card" Tag="CREDIT_CARD" />
                                <ComboBoxItem Content="Store Credit / Adjustment" Tag="ADJUSTMENT" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="ReturnStatusText" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10" />

                    <DockPanel LastChildFill="False">
                        <Button x:Name="PreviewReturnButton" DockPanel.Dock="Left" Content="{DynamicResource RetPreviewButton}" Style="{StaticResource SecondaryButton}" MinWidth="150" Click="PreviewReturn_Click" />
                        <Button x:Name="FinalizeReturnButton" DockPanel.Dock="Right" Content="{DynamicResource RetFinalizeButton}" Style="{StaticResource PrimaryButton}" MinWidth="180" Click="FinalizeReturn_Click" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
            </Grid>
    </Grid>
</UserControl>
