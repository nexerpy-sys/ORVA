<Window x:Class="Orva.Views.AddStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:Orva.Controls"
        Title="ORVA — Add Stock" Width="760" Height="760" MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Paper}">
    <Grid fx:OrvaFx.Reveal="Dialog" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="INVENTORY  /  STOCK RECEIPT" Style="{StaticResource MetadataText}" />
            <TextBlock Text="{DynamicResource AddStockTitle}" Style="{StaticResource DisplayHeading}" FontSize="27" Margin="0,5,0,4" />
            <TextBlock Text="Enter the medicine and batch details. ORVA updates available stock after you save." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
            <Border Height="2" Background="{StaticResource Vermilion}" Width="54" HorizontalAlignment="Left" Margin="0,14,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource MedicineDetails}" Style="{StaticResource SectionHeading}" Margin="0,0,0,13" />
                <TextBlock Text="{DynamicResource MedicineName}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="MedicineNameBox" MaxLength="160" Margin="0,0,0,12" ToolTip="Enter the medicine name" TextChanged="MedicineName_TextChanged" LostFocus="MedicineName_LostFocus" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource StockUnit}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="UnitBox" IsEditable="True" Text="strip">
                            <ComboBoxItem Content="strip" />
                            <ComboBoxItem Content="tablet" />
                            <ComboBoxItem Content="capsule" />
                            <ComboBoxItem Content="bottle" />
                            <ComboBoxItem Content="box" />
                            <ComboBoxItem Content="vial" />
                            <ComboBoxItem Content="tube" />
                            <ComboBoxItem Content="pack" />
                            <ComboBoxItem Content="ampoule" />
                            <ComboBoxItem Content="sachet" />
                            <ComboBoxItem Content="piece" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource BatchNumber}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="BatchNumberBox" MaxLength="40" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource ExpiryDate}" Style="{StaticResource FieldLabel}" />
                <Grid Margin="0,0,0,19">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="ExpiryMonthBox" Grid.Column="0" />
                    <ComboBox x:Name="ExpiryYearBox" Grid.Column="2" />
                </Grid>

                <TextBlock Text="QUANTITY AND PRICING" Style="{StaticResource SectionHeading}" Margin="0,0,0,13" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource QuantityReceived}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="QuantityBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource PurchasePrice}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PurchasePriceBox" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource MrpPrice}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MrpBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <TextBlock Text="The unit is saved with this medicine and reused for future stock entries." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                    </StackPanel>
                </Grid>

                <Expander Header="{DynamicResource PurchaseDetailsOptional}" Foreground="{StaticResource Teal}" FontWeight="SemiBold" IsExpanded="False" Margin="0,0,0,14">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource SupplierBoughtFrom}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SupplierBox" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource SupplierLicence}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SupplierLicenceBox" Margin="0,0,0,10" />
                        <TextBlock Text="{DynamicResource PurchaseDocument}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="DocumentTypeBox" SelectedIndex="0" Margin="0,0,0,10">
                            <ComboBoxItem Content="No formal document" Tag="NO_DOCUMENT" />
                            <ComboBoxItem Content="Tax invoice" Tag="TAX_INVOICE" />
                            <ComboBoxItem Content="Cash / credit memo" Tag="CASH_CREDIT_MEMO" />
                            <ComboBoxItem Content="Other document" Tag="OTHER" />
                        </ComboBox>
                        <TextBlock Text="{DynamicResource DocumentReference}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DocumentReferenceBox" />
                    </StackPanel>
                </Expander>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,12" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="* Required fields" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{DynamicResource Cancel}" Style="{StaticResource SecondaryButton}" MinWidth="100" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="{DynamicResource SaveStock}" Style="{StaticResource PrimaryButton}" MinWidth="150" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>