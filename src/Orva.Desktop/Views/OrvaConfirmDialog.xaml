<Window x:Class="Orva.Views.OrvaConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:Orva.Controls"
        Title="ORVA"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MinWidth="420" MaxWidth="520" MaxHeight="520"
        Background="{StaticResource Paper}"
        BorderBrush="{StaticResource Ink}"
        BorderThickness="1">
    <Grid fx:OrvaFx.Reveal="Dialog">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Teal}"
                fx:OrvaFx.Grain="True"
                MouseLeftButtonDown="Header_MouseLeftButtonDown"
                Padding="18,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" Width="28" Height="28"
                        FontSize="16" FontWeight="Bold"
                        Background="Transparent" Foreground="{StaticResource Paper}"
                        BorderThickness="0" IsCancel="True" Click="Close_Click"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="ORVA"
                           FontFamily="{StaticResource UiHeadingFont}"
                           FontSize="18" Foreground="{StaticResource Paper}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Height="10" Background="{StaticResource Vermilion}" ClipToBounds="True">
            <Border.OpacityMask>
                <DrawingBrush TileMode="Tile" Viewport="0,0,14,10" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Black">
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M 0,0 L 14,0 L 14,10 A 5,5 0 0 0 4,10 L 0,10 Z" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.OpacityMask>
            <Rectangle Height="10" Fill="{StaticResource Vermilion}" />
        </Border>

        <StackPanel Grid.Row="2" Margin="22,18,22,8">
            <Border x:Name="WarningBar" Height="3" Width="46"
                    HorizontalAlignment="Left" Margin="0,0,0,12"
                    Background="{StaticResource Vermilion}" Visibility="Collapsed" />
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" Text=""
                       FontFamily="{StaticResource UiBodyFont}"
                       FontSize="14" Foreground="{StaticResource Ink}"
                       TextWrapping="Wrap" LineHeight="21" />
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="22,10,22,20">
            <Button x:Name="CancelButton" Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="96" Margin="0,0,10,0"
                    IsCancel="True" Click="Close_Click" Visibility="Collapsed" />
            <Button x:Name="OkButton" Content="Done"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="120" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
