<Window x:Class="Orva.Views.EditMedicineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:Orva.Controls"
        Title="ORVA — Edit Medicine" Width="600" Height="560" MinWidth="500" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Paper}" FontFamily="{StaticResource UiBodyFont}">
    <Grid fx:OrvaFx.Reveal="Dialog" Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="INVENTORY  /  MEDICINE CATALOGUE" Style="{StaticResource MetadataText}" />
            <TextBlock Text="{DynamicResource InvEditMedicineTitle}" Style="{StaticResource DisplayHeading}" FontSize="24" Margin="0,4,0,4" />
            <TextBlock Text="Historical invoices keep their original snapshots. Stock unit cannot be changed once recorded." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
            <Border Height="2" Background="{StaticResource Vermilion}" Width="50" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{DynamicResource MedicineName}" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DisplayNameBox" Margin="0,0,0,12" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource InvGenericName}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="GenericNameBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource InvBrandName}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="BrandNameBox" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource InvStrength}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="StrengthBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource InvDosageForm}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DosageFormBox" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource InvLowStockThreshold}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ThresholdBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource StockUnit}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="UnitBox" IsReadOnly="True" Background="{StaticResource PaperRecessed}" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="IsActiveCheck" Content="{DynamicResource InvMedicineActive}" FontSize="13" Margin="0,4,0,12" />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="{DynamicResource Cancel}" Style="{StaticResource SecondaryButton}" MinWidth="100" IsCancel="True" Click="Cancel_Click" />
            <Button Content="{DynamicResource InvSaveMedicine}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" MinWidth="160" IsDefault="True" Click="Save_Click" />
        </DockPanel>
    </Grid>
</Window>
