<UserControl x:Class="Orva.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="clr-namespace:Orva.Controls"
             Background="Transparent"
             FontFamily="{StaticResource UiBodyFont}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- EDITORIAL ARCHIVAL MASTHEAD -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                <fx:RegistrationMark DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="03" FontFamily="{StaticResource UiMonoFont}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource FederalBlue}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Width="1" Height="12" Background="{StaticResource Rule}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource InvArchiveTitle}" Style="{StaticResource DisplayHeading}" FontSize="24" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{DynamicResource InvArchiveSubtitle}" Style="{StaticResource MetadataText}" Margin="0,2,0,8" />
            <Grid>
                <Border Height="1.5" Background="{StaticResource Ink}" Opacity="0.85" />
                <Border Height="2" Width="64" HorizontalAlignment="Left" Background="{StaticResource FederalBlue}" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Width="200" Margin="0,0,8,4" KeyDown="SearchBox_KeyDown" ToolTip="Invoice number or customer name" />
                <ComboBox x:Name="StatusFilterCombo" Width="145" Margin="0,0,8,4" SelectedIndex="0" SelectionChanged="StatusFilterCombo_SelectionChanged">
                    <ComboBoxItem Content="ALL" />
                    <ComboBoxItem Content="ISSUED" />
                    <ComboBoxItem Content="CREDIT_NOTE_ISSUED" />
                    <ComboBoxItem Content="CANCELLED" />
                </ComboBox>
                <TextBlock Text="{DynamicResource CommonFrom}" VerticalAlignment="Center" Margin="4,0,4,4" />
                <DatePicker x:Name="FromDatePicker" Width="120" Margin="0,0,8,4" />
                <TextBlock Text="{DynamicResource CommonTo}" VerticalAlignment="Center" Margin="4,0,4,4" />
                <DatePicker x:Name="ToDatePicker" Width="120" Margin="0,0,8,4" />
                <Button Content="{DynamicResource InvSearchButton}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,4" Click="Refresh_Click" />
                <Button Content="{DynamicResource InvReprintButton}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Click="ReprintInvoice_Click" />
                <Button Content="{DynamicResource RepExportCsv}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,4" Click="ExportCsv_Click" />
                <Button Content="{DynamicResource CommonExportExcel}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,4" Click="ExportXlsx_Click" />
                <Button Content="{DynamicResource CommonExportPdf}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,4" Click="ExportPdf_Click" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" x:Name="InvoicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}"
                      SelectionMode="Single" MinRowHeight="38" HorizontalScrollBarVisibility="Auto" HeadersVisibility="Column"
                      SelectionChanged="InvoicesGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="INVOICE NO" Binding="{Binding InvoiceNumber}" Width="1.2*" MinWidth="110" />
                    <DataGridTextColumn Header="DATE" Binding="{Binding IssuedDateText}" Width="1.05*" MinWidth="95" />
                    <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="1.35*" MinWidth="100" />
                    <DataGridTextColumn Header="TAXABLE (₹)" Binding="{Binding TaxableText}" Width="0.85*" MinWidth="72" />
                    <DataGridTextColumn Header="TAX (₹)" Binding="{Binding TaxTotalText}" Width="0.75*" MinWidth="62" />
                    <DataGridTextColumn Header="TOTAL (₹)" Binding="{Binding GrandTotalText}" Width="0.9*" MinWidth="78" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="1.0*" MinWidth="88" />
                    <DataGridTextColumn Header="CANCEL REASON" Binding="{Binding CancellationReason}" Width="1.1*" MinWidth="90" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Ink}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource FederalBlue}" />
                    <Grid Grid.Row="1" Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource InvDetailLabel}" Style="{StaticResource MetadataText}" />
                        <TextBlock Grid.Row="1" x:Name="DetailHeaderText" Text="{DynamicResource InvDetailPrompt}" FontFamily="{StaticResource UiHeadingFont}" FontSize="16" Foreground="{StaticResource Teal}" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <ListBox Grid.Row="2" x:Name="InvoiceDetailLines" BorderThickness="0" Background="Transparent" />
                        <TextBlock Grid.Row="3" x:Name="DetailFooterText" Style="{StaticResource MetadataText}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource InvCancelReasonLabel}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                    <TextBox x:Name="CancelReasonBox" Width="260" MaxLength="240" Margin="0,0,10,0" ToolTip="Enter reason before cancelling selected invoice" />
                    <Button Content="{DynamicResource InvCancelButton}" Style="{StaticResource SecondaryButton}" Click="CancelInvoice_Click" />
                </WrapPanel>
                <TextBlock Grid.Column="1" x:Name="StatusText" Style="{StaticResource MetadataText}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
