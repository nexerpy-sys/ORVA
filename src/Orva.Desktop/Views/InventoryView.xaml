<UserControl x:Class="Orva.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="clr-namespace:Orva.Controls"
             Background="Transparent"
             FontFamily="{StaticResource UiBodyFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- EDITORIAL ARCHIVAL MASTHEAD (TWO-PLATE COBALT + INK + REGISTRATION MARK) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                <fx:RegistrationMark DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="02" FontFamily="{StaticResource UiMonoFont}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource FederalBlue}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Width="1" Height="12" Background="{StaticResource Rule}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource NavInventory}" Style="{StaticResource MetadataText}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
                <Border Height="1.5" Background="{StaticResource Ink}" Opacity="0.85" />
                <Border Height="2" Width="64" HorizontalAlignment="Left" Background="{StaticResource FederalBlue}" />
            </Grid>
        </Grid>

        <!-- SEARCH & PRIMARY STOCK ACTIONS (WRAPS CLEANLY AT 1000px) -->
        <Border Grid.Row="1" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" fx:OrvaFx.Spotlight="True" Padding="14" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Bottom">
                <StackPanel Width="240" Margin="0,0,12,4">
                    <TextBlock Text="{DynamicResource FindMedicineBatch}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="Search by medicine name, batch number, or barcode" />
                </StackPanel>
                <Button Content="{DynamicResource AddStock}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,4" Click="AddStock_Click" />
                <Button Content="{DynamicResource InvImportStockButton}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,4" Click="ImportStock_Click" />
                <Button Content="{DynamicResource RefreshStockFile}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,4" Click="RefreshSnapshot_Click" />
                <Button Content="{DynamicResource OpenShopFolder}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,4" Click="OpenFolder_Click" />
            </WrapPanel>
        </Border>

        <!-- UNIFIED ARCHITECTURAL LEDGER STRIP (REPLACES 5 ROUNDED ERP CARDS) -->
        <Border Grid.Row="2" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Ink}" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="14,10">
                    <Border Height="2" Width="24" HorizontalAlignment="Left" Background="{StaticResource FederalBlue}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Medicines}" Style="{StaticResource MetadataText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MedicineCountText" Text="0" FontFamily="{StaticResource UiMonoFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Teal}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Rule}" />

                <StackPanel Grid.Column="2" Margin="14,10">
                    <Border Height="2" Width="24" HorizontalAlignment="Left" Background="{StaticResource Teal}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource Batches}" Style="{StaticResource MetadataText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="BatchCountText" Text="0" FontFamily="{StaticResource UiMonoFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Teal}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="3" Background="{StaticResource Rule}" />

                <StackPanel Grid.Column="4" Margin="14,10">
                    <Border Height="2" Width="24" HorizontalAlignment="Left" Background="{StaticResource Vermilion}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource InvLowStockAlerts}" Style="{StaticResource MetadataText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="LowStockCountText" Text="0" FontFamily="{StaticResource UiMonoFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Vermilion}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="5" Background="{StaticResource Rule}" />

                <StackPanel Grid.Column="6" Margin="14,10">
                    <Border Height="2" Width="24" HorizontalAlignment="Left" Background="{StaticResource Danger}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource InvExpiryAlerts}" Style="{StaticResource MetadataText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ExpiryAlertCountText" Text="0" FontFamily="{StaticResource UiMonoFont}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Danger}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="7" Background="{StaticResource Rule}" />

                <StackPanel Grid.Column="8" Margin="14,10">
                    <Border Height="2" Width="24" HorizontalAlignment="Left" Background="{StaticResource Success}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource PortableStockFile}" Style="{StaticResource MetadataText}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SnapshotStatusText" Text="Ready to update" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Success}" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTER & ROW ACTIONS (WRAPS CLEANLY AT 1000px) -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,10">
            <Button x:Name="FilterAllButton" Content="{DynamicResource InvFilterAll}" Style="{StaticResource PrimaryButton}" MinHeight="34" Padding="12,6" Margin="0,0,6,6" Click="FilterAll_Click" />
            <Button x:Name="FilterLowStockButton" Content="{DynamicResource InvFilterLowStock}" Style="{StaticResource SecondaryButton}" MinHeight="34" Padding="12,6" Margin="0,0,6,6" Click="FilterLowStock_Click" />
            <Button x:Name="FilterExpiringButton" Content="{DynamicResource InvFilterExpiring}" Style="{StaticResource SecondaryButton}" MinHeight="34" Padding="12,6" Margin="0,0,6,6" Click="FilterExpiring_Click" />
            <Button x:Name="FilterExpiredButton" Content="{DynamicResource InvFilterExpired}" Style="{StaticResource SecondaryButton}" MinHeight="34" Padding="12,6" Margin="0,0,14,6" Click="FilterExpired_Click" />
            <Button Content="{DynamicResource CatImportButton}" Style="{StaticResource SecondaryButton}" MinHeight="34" Padding="12,6" Margin="0,0,6,6" Click="ImportCatalogue_Click" />
            <Button x:Name="EditMedicineButton" Content="{DynamicResource InvEditMedicineButton}" Style="{StaticResource SecondaryButton}" MinHeight="34" Padding="12,6" Margin="0,0,6,6" IsEnabled="False" Click="EditMedicine_Click" />
            <Button x:Name="AdjustStockButton" Content="{DynamicResource InvAdjustStockButton}" Style="{StaticResource SecondaryButton}" MinHeight="34" Padding="12,6" Margin="0,0,0,6" IsEnabled="False" Click="AdjustStock_Click" />
        </WrapPanel>

        <!-- CLEAN WORKING INVENTORY TABLE -->
        <Border Grid.Row="4" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" fx:OrvaFx.Spotlight="True" Padding="1">
            <DataGrid x:Name="InventoryGrid" AutoGenerateColumns="False" CanUserSortColumns="True" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" Margin="0" SelectionMode="Single" SelectionChanged="InventoryGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MEDICINE" Binding="{Binding MedicineName}" Width="2.4*" MinWidth="180" />
                    <DataGridTextColumn Header="BATCH" Binding="{Binding BatchNumber}" Width="1.1*" MinWidth="90" />
                    <DataGridTextColumn Header="EXPIRY" Binding="{Binding Expiry}" Width="0.9*" MinWidth="80" />
                    <DataGridTextColumn Header="AVAILABLE" Binding="{Binding Quantity}" Width="0.9*" MinWidth="90" />
                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="0.8*" MinWidth="70" />
                    <DataGridTextColumn Header="MRP (₹)" Binding="{Binding Mrp}" Width="1*" MinWidth="85" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="1.2*" MinWidth="110" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>