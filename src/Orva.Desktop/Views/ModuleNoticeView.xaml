<UserControl x:Class="Orva.Views.ModuleNoticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Border Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="28" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="ORVA  /  RINDLE WORKS" Style="{StaticResource MetadataText}" />
                <TextBlock x:Name="TitleText" Text="This section is being built" FontFamily="{StaticResource UiHeadingFont}" FontSize="25" Foreground="{StaticResource Teal}" Margin="0,12,0,8" />
                <TextBlock x:Name="NoticeText" FontSize="14" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="720" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>