<UserControl x:Class="Orva.Views.RecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="clr-namespace:Orva.Controls"
             Background="Transparent"
             FontFamily="{StaticResource UiBodyFont}">
    <UserControl.Resources>
        <Style x:Key="MonoRightCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiMonoFont}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Padding" Value="0,0,4,0" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- EDITORIAL ARCHIVAL MASTHEAD -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                <fx:RegistrationMark DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="05" FontFamily="{StaticResource UiMonoFont}" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource FederalBlue}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Width="1" Height="12" Background="{StaticResource Rule}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{DynamicResource NavRecords}" Style="{StaticResource MetadataText}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <Grid Grid.Row="1">
                <Border Height="1.5" Background="{StaticResource Ink}" Opacity="0.85" />
                <Border Height="2" Width="64" HorizontalAlignment="Left" Background="{StaticResource FederalBlue}" />
            </Grid>
        </Grid>

        <!-- SHARED DATE / FINANCIAL YEAR FILTER BAR -->
        <Border Grid.Row="1" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" fx:OrvaFx.Spotlight="True" Padding="10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource CommonFrom}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                <DatePicker x:Name="FromDatePicker" Width="125" Margin="0,0,10,0" />
                <TextBlock Text="{DynamicResource CommonTo}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                <DatePicker x:Name="ToDatePicker" Width="125" Margin="0,0,10,0" />
                <Button Content="{DynamicResource CommonApplyFilter}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ApplyFilter_Click" />
                <Button Content="{DynamicResource CommonCurrentFy}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CurrentFy_Click" />
                <Button Content="{DynamicResource CommonAllDates}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0" Click="ClearFilter_Click" />
                <TextBlock x:Name="FilterStatusText" Style="{StaticResource MetadataText}" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="2" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}">

            <!-- 1. PURCHASE REGISTER -->
            <TabItem Header="{DynamicResource RepPurchasesTab}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{DynamicResource RepExportCsv}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportPurchases_Click" />
                            <Button Content="{DynamicResource CommonExportExcel}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportPurchasesXlsx_Click" />
                            <Button Content="{DynamicResource CommonExportPdf}" Style="{StaticResource PrimaryButton}" Click="ExportPurchasesPdf_Click" />
                        </StackPanel>
                        <TextBlock x:Name="PurchaseSummaryText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,0,12,0" TextWrapping="Wrap" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="PurchaseGrid" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding ReceivedDateText}" Width="1.3*" MinWidth="115" />
                            <DataGridTextColumn Header="SUPPLIER" Binding="{Binding SupplierName}" Width="1.6*" MinWidth="140" />
                            <DataGridTextColumn Header="DOCUMENT TYPE" Binding="{Binding DocumentType}" Width="1.2*" MinWidth="115" />
                            <DataGridTextColumn Header="REFERENCE" Binding="{Binding DocumentReference}" Width="1.2*" MinWidth="115" />
                            <DataGridTextColumn Header="TOTAL (₹)" Binding="{Binding TotalText}" Width="1*" MinWidth="105" ElementStyle="{StaticResource MonoRightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 2. GST SUMMARY (NET OF RETURNS, CA REVIEW) -->
            <TabItem Header="{DynamicResource RepGstTab}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{DynamicResource RepExportCsv}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportGst_Click" />
                            <Button Content="{DynamicResource CommonExportExcel}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportGstXlsx_Click" />
                            <Button Content="{DynamicResource CommonExportPdf}" Style="{StaticResource PrimaryButton}" Click="ExportGstPdf_Click" />
                        </StackPanel>
                        <TextBlock x:Name="GstSummaryText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,0,12,0" TextWrapping="Wrap" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="GstGrid" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="HSN" Binding="{Binding HsnCode}" Width="1.1*" MinWidth="95" />
                            <DataGridTextColumn Header="GST RATE" Binding="{Binding GstRateText}" Width="0.8*" MinWidth="85" />
                            <DataGridTextColumn Header="NET TAXABLE (₹)" Binding="{Binding TaxableText}" Width="1.1*" MinWidth="120" ElementStyle="{StaticResource MonoRightCell}" />
                            <DataGridTextColumn Header="NET CGST (₹)" Binding="{Binding CgstText}" Width="0.9*" MinWidth="105" ElementStyle="{StaticResource MonoRightCell}" />
                            <DataGridTextColumn Header="NET SGST (₹)" Binding="{Binding SgstText}" Width="0.9*" MinWidth="105" ElementStyle="{StaticResource MonoRightCell}" />
                            <DataGridTextColumn Header="NET IGST (₹)" Binding="{Binding IgstText}" Width="0.9*" MinWidth="105" ElementStyle="{StaticResource MonoRightCell}" />
                            <DataGridTextColumn Header="NET TOTAL (₹)" Binding="{Binding TotalText}" Width="1.1*" MinWidth="115" ElementStyle="{StaticResource MonoRightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 3. SALES RETURNS / CREDIT NOTES -->
            <TabItem Header="{DynamicResource RepReturnsTab}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{DynamicResource RepExportCsv}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportReturns_Click" />
                            <Button Content="{DynamicResource CommonExportExcel}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportReturnsXlsx_Click" />
                            <Button Content="{DynamicResource CommonExportPdf}" Style="{StaticResource PrimaryButton}" Click="ExportReturnsPdf_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ReturnsSummaryText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,0,12,0" TextWrapping="Wrap" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="ReturnsGrid" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RETURN NO" Binding="{Binding ReturnNumber}" Width="1.2*" MinWidth="120" />
                            <DataGridTextColumn Header="INVOICE NO" Binding="{Binding InvoiceNumber}" Width="1.2*" MinWidth="120" />
                            <DataGridTextColumn Header="DATE" Binding="{Binding ReturnedDateText}" Width="1.1*" MinWidth="110" />
                            <DataGridTextColumn Header="REFUND METHOD" Binding="{Binding RefundMethod}" Width="0.9*" MinWidth="115" />
                            <DataGridTextColumn Header="REFUND (₹)" Binding="{Binding RefundText}" Width="0.9*" MinWidth="105" ElementStyle="{StaticResource MonoRightCell}" />
                            <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="1.8*" MinWidth="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 4. STOCK VALUATION -->
            <TabItem Header="{DynamicResource RepValuationTab}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{DynamicResource RepExportCsv}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportValuation_Click" />
                            <Button Content="{DynamicResource CommonExportExcel}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="ExportValuationXlsx_Click" />
                            <Button Content="{DynamicResource CommonExportPdf}" Style="{StaticResource PrimaryButton}" Click="ExportValuationPdf_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ValuationSummaryText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,0,12,0" TextWrapping="Wrap" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" x:Name="ValuationGrid" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MEDICINE" Binding="{Binding MedicineName}" Width="2*" MinWidth="160" />
                            <DataGridTextColumn Header="USABLE STOCK" Binding="{Binding QuantityText}" Width="1.1*" MinWidth="110" />
                            <DataGridTextColumn Header="COST VALUE (₹)" Binding="{Binding CostValueText}" Width="1.1*" MinWidth="115" ElementStyle="{StaticResource MonoRightCell}" />
                            <DataGridTextColumn Header="MRP VALUE (₹)" Binding="{Binding MrpValueText}" Width="1.1*" MinWidth="115" ElementStyle="{StaticResource MonoRightCell}" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding AlertText}" Width="0.8*" MinWidth="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 5. EXPENSE RECORDS -->
            <TabItem Header="{DynamicResource RepExpensesTab}">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="{DynamicResource ExpCategory}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExpenseCategoryBox" Width="130" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="{DynamicResource ExpDescription}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExpenseDescBox" Width="190" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="{DynamicResource ExpAmount}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExpenseAmountBox" Width="95" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="{DynamicResource ExpDocRef}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ExpenseRefBox" Width="110" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,4">
                            <TextBlock Text="{DynamicResource ExpPayment}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="ExpenseMethodBox" Width="105" SelectedIndex="0">
                                <ComboBoxItem Content="Cash" Tag="CASH" />
                                <ComboBoxItem Content="UPI" Tag="UPI" />
                                <ComboBoxItem Content="Debit Card" Tag="DEBIT_CARD" />
                                <ComboBoxItem Content="Credit Card" Tag="CREDIT_CARD" />
                            </ComboBox>
                        </StackPanel>
                        <Button Content="{DynamicResource RepAddExpense}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,4" Click="AddExpense_Click" />
                        <Button Content="{DynamicResource RepExportCsv}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,4" Click="ExportExpenses_Click" />
                        <Button Content="{DynamicResource CommonExportExcel}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,4" Click="ExportExpensesXlsx_Click" />
                        <Button Content="{DynamicResource CommonExportPdf}" Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Margin="0,0,0,4" Click="ExportExpensesPdf_Click" />
                    </WrapPanel>
                    <TextBlock Grid.Row="1" x:Name="ExpenseSummaryText" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,0,0,8" />
                    <DataGrid Grid.Row="2" x:Name="ExpenseGrid" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding ExpenseDateText}" Width="1.2*" MinWidth="110" />
                            <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1.1*" MinWidth="105" />
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="1.8*" MinWidth="150" />
                            <DataGridTextColumn Header="REF" Binding="{Binding DocumentReference}" Width="1*" MinWidth="95" />
                            <DataGridTextColumn Header="METHOD" Binding="{Binding PaymentMethod}" Width="0.9*" MinWidth="90" />
                            <DataGridTextColumn Header="AMOUNT (₹)" Binding="{Binding AmountText}" Width="0.9*" MinWidth="105" ElementStyle="{StaticResource MonoRightCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
