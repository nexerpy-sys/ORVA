<UserControl x:Class="Orva.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="clr-namespace:Orva.Controls"
             Background="Transparent"
             FontFamily="{StaticResource UiBodyFont}">

    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource UiBodyFont}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource UiBodyFont}" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontFamily" Value="{StaticResource UiBodyFont}" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PaperRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,18">
            <Grid Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                    <fx:RegistrationMark DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="06" FontFamily="{StaticResource UiMonoFont}" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource FederalBlue}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Border Width="1" Height="12" Background="{StaticResource Rule}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource NavSettings}" Style="{StaticResource MetadataText}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Border Height="1.5" Background="{StaticResource Ink}" Opacity="0.85" />
                    <Border Height="2" Width="64" HorizontalAlignment="Left" Background="{StaticResource FederalBlue}" />
                </Grid>
            </Grid>

            <!-- 1. SHOP PROFILE & STATE CODE -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SettingsShopSection}" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource SettingsShopHint}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SettingsShopName}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ShopNameBox" />
                    </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource SettingsInvoicePrefix}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="InvoicePrefixBox" MaxLength="3" CharacterCasing="Upper" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SettingsShopState}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="StateComboBox" DisplayMemberPath="DisplayLabel" SelectionChanged="StateComboBox_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource SettingsStateCode}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="StateCodeBox" IsReadOnly="True" Background="{StaticResource PaperRecessed}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SettingsShopGstin}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ShopGstinBox" MaxLength="15" CharacterCasing="Upper" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource SettingsDrugLicence}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DrugLicenceBox" />
                        </StackPanel>
                    </Grid>

                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource SettingsSaveShop}" Style="{StaticResource PrimaryButton}" MinWidth="170" Click="SaveShop_Click" />
                        <TextBlock x:Name="ShopStatusText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 2. SHOP-LEVEL TAX CONFIGURATION -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6" LastChildFill="True">
                        <Border x:Name="TaxStatusBadge" DockPanel.Dock="Right" Padding="10,4" VerticalAlignment="Center" Background="#F6E4DE">
                            <TextBlock x:Name="TaxStatusBadgeText" Text="{DynamicResource SettingsTaxNotConfigured}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Vermilion}" />
                        </Border>
                        <TextBlock Text="{DynamicResource SettingsTaxSection}" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{DynamicResource SettingsTaxHint}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SettingsTaxPricingMode}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="PricingModeBox">
                                <ComboBoxItem Content="{DynamicResource SettingsPricingInclusive}" Tag="INCLUSIVE" />
                                <ComboBoxItem Content="{DynamicResource SettingsPricingExclusive}" Tag="EXCLUSIVE" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource SettingsDefaultSupplyType}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SupplyTypeBox">
                                <ComboBoxItem Content="{DynamicResource SettingsSupplyIntra}" Tag="INTRA_STATE" />
                                <ComboBoxItem Content="{DynamicResource SettingsSupplyInter}" Tag="INTER_STATE" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{DynamicResource SettingsRoundOffMode}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="RoundOffBox">
                                <ComboBoxItem Content="{DynamicResource SettingsRoundOffNone}" Tag="NONE" />
                                <ComboBoxItem Content="{DynamicResource SettingsRoundOffNearest}" Tag="NEAREST_RUPEE" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="TaxConfiguredCheck"
                              Content="{DynamicResource SettingsConfirmTaxConfigured}"
                              FontSize="13"
                              Foreground="{StaticResource Ink}"
                              Margin="0,4,0,14" />

                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource SettingsSaveTax}" Style="{StaticResource PrimaryButton}" MinWidth="170" Click="SaveTax_Click" />
                        <TextBlock x:Name="TaxSaveMessageText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 3. PER-MEDICINE GST & HSN CONFIGURATION -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SettingsMedicineTaxSection}" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource SettingsMedicineTaxHint}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <TextBlock Text="{DynamicResource SettingsFindMedicine}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="MedicineSearchBox" Margin="0,0,0,12" TextChanged="MedicineSearchBox_TextChanged" />

                    <DataGrid x:Name="MedicineTaxGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              Height="220"
                              Margin="0,0,0,14"
                              SelectionChanged="MedicineTaxGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MEDICINE" Binding="{Binding DisplayName}" Width="2.2*" MinWidth="160" />
                            <DataGridTextColumn Header="UNIT" Binding="{Binding StockUnitName}" Width="0.7*" MinWidth="70" />
                            <DataGridTextColumn Header="HSN" Binding="{Binding HsnCode}" Width="0.9*" MinWidth="85" />
                            <DataGridTextColumn Header="GST RATE" Binding="{Binding GstRatePercentText}" Width="0.8*" MinWidth="80" />
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusText}" Width="1*" MinWidth="110" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Background="#F6F0E5" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="SelectedMedicineLabel" Text="{DynamicResource SettingsSelectMedicinePrompt}" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource SettingsMedicineHsn}" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="MedicineHsnBox" MaxLength="8" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource SettingsMedicineGstPercent}" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="MedicineGstRateBox" IsEditable="True">
                                        <ComboBoxItem Content="0" />
                                        <ComboBoxItem Content="5" />
                                        <ComboBoxItem Content="12" />
                                        <ComboBoxItem Content="18" />
                                        <ComboBoxItem Content="28" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="MedicineGstConfiguredCheck"
                                      Content="{DynamicResource SettingsMedicineConfirmConfigured}"
                                      FontSize="12.5"
                                      Foreground="{StaticResource Ink}"
                                      Margin="0,2,0,12" />

                            <DockPanel LastChildFill="True">
                                <Button x:Name="SaveMedicineTaxButton"
                                        DockPanel.Dock="Right"
                                        Content="{DynamicResource SettingsSaveMedicineTax}"
                                        Style="{StaticResource PrimaryButton}"
                                        MinWidth="170"
                                        IsEnabled="False"
                                        Click="SaveMedicineTax_Click" />
                                <TextBlock x:Name="MedicineTaxMessageText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>



                
            <!-- 4. COMPLETE SHOP BACKUP & RESTORE -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource BackupSectionHeading}" Style="{StaticResource SectionHeading}" Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource BackupSectionHint}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F6F0E5" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource BackupLastLabel}" Style="{StaticResource MetadataText}" />
                                <TextBlock x:Name="LastBackupText" Text="—" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#F6F0E5" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource BackupStatusLabel}" Style="{StaticResource MetadataText}" />
                                <TextBlock x:Name="BackupStatusText" Text="—" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Success}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="BackupLocationText" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="{DynamicResource BackupNowButton}" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="0,0,10,8" Click="BackupNow_Click" />
                        <Button Content="{DynamicResource BackupExportButton}" Style="{StaticResource SecondaryButton}" MinWidth="210" Margin="0,0,10,8" Click="ExportBackup_Click" />
                        <Button Content="{DynamicResource BackupRestoreButton}" Style="{StaticResource SecondaryButton}" MinWidth="210" Margin="0,0,0,8" Click="RestoreBackup_Click" />
                    </WrapPanel>

                    <TextBlock x:Name="BackupActionMessageText" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- PRINTING, BACKUP RETENTION & SUPPORT/UPI SETTINGS -->
            <Border Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" fx:OrvaFx.Spotlight="True" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetOpsTitle}" Style="{StaticResource SectionHeading}" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SetDefaultPaper}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="DefaultPaperFormatCombo">
                                <ComboBoxItem Content="58 mm Thermal" Tag="Thermal58" />
                                <ComboBoxItem Content="80 mm Thermal" Tag="Thermal80" />
                                <ComboBoxItem Content="A5 Invoice" Tag="A5" />
                                <ComboBoxItem Content="A4 Invoice" Tag="A4" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource SetBackupRetention}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="BackupRetentionDaysBox" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SetSupportPhones}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SupportPhonesBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource SetSupportWhatsapp}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="SupportWhatsappBox" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource SetMerchantUpi}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="MerchantUpiIdBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource SetMerchantPayee}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="MerchantUpiPayeeBox" />
                        </StackPanel>
                    </Grid>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource SetSavePrefs}" Style="{StaticResource PrimaryButton}" MinWidth="170" Click="SaveOperationalPrefs_Click" />
                        <TextBlock x:Name="OperationalPrefsMessageText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Margin="0,0,12,0" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
