<Window x:Class="Orva.Views.RestoreBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:Orva.Controls"
        Title="ORVA — Restore Complete Shop Backup" Width="640" Height="620" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Paper}" FontFamily="{StaticResource UiBodyFont}">
    <Grid fx:OrvaFx.Reveal="Dialog" Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="DATA SAFETY  /  COMPLETE SHOP RESTORE" Style="{StaticResource MetadataText}" />
            <TextBlock Text="{DynamicResource BackupRestoreTitle}" Style="{StaticResource DisplayHeading}" FontSize="24" Margin="0,4,0,4" />
            <TextBlock Text="{DynamicResource BackupRestoreWarning}" Foreground="{StaticResource Danger}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Border Height="2" Background="{StaticResource Vermilion}" Width="54" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,14" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="{DynamicResource InvChooseFile}" Style="{StaticResource SecondaryButton}" MinWidth="130" Margin="10,0,0,0" Click="ChooseFile_Click" />
                    <TextBox x:Name="FilePathBox" IsReadOnly="True" Background="{StaticResource PaperRecessed}" />
                </DockPanel>

                <Border x:Name="PreviewCard" Visibility="Collapsed" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource BackupPreviewHeading}" Style="{StaticResource SectionHeading}" FontSize="15" Margin="0,0,0,10" />
                        <TextBlock x:Name="SourceShopText" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock x:Name="BackupMetaText" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                        <TextBlock x:Name="RecordCountsText" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <Border x:Name="DifferentShopBanner" Visibility="Collapsed" Background="#F6E4DE" BorderBrush="{StaticResource Vermilion}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <TextBlock x:Name="DifferentShopText" Foreground="{StaticResource Ink}" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <CheckBox x:Name="ConfirmReplaceCheck"
                                  Content="{DynamicResource BackupConfirmReplace}"
                                  FontSize="12.5"
                                  FontWeight="SemiBold"
                                  Margin="0,4,0,4"
                                  Checked="ConfirmReplace_Changed"
                                  Unchecked="ConfirmReplace_Changed" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="{DynamicResource Cancel}" Style="{StaticResource SecondaryButton}" MinWidth="100" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="RestoreButton" Content="{DynamicResource BackupConfirmRestore}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" MinWidth="200" IsEnabled="False" Click="Restore_Click" />
        </DockPanel>
    </Grid>
</Window>
