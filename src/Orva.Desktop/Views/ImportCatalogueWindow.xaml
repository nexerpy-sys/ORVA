<Window x:Class="Orva.Views.ImportCatalogueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:Orva.Controls"
        Title="ORVA — Import Medicine Catalogue (CSV)" Width="640" Height="560" MinWidth="540" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Paper}" FontFamily="{StaticResource UiBodyFont}">
    <Grid fx:OrvaFx.Reveal="Dialog" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="INVENTORY  /  BULK CSV ONBOARDING" Style="{StaticResource MetadataText}" />
            <TextBlock Text="{DynamicResource CatImportTitle}" Style="{StaticResource DisplayHeading}" FontSize="23" Margin="0,4,0,4" />
            <TextBlock Text="{DynamicResource CatImportHint}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Margin="0,0,0,12" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="{DynamicResource CatDownloadTemplate}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Template_Click" />
                    <Button DockPanel.Dock="Right" Content="{DynamicResource InvChooseFile}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ChooseFile_Click" />
                    <TextBox x:Name="FilePathBox" IsReadOnly="True" Background="{StaticResource PaperRecessed}" />
                </DockPanel>

                <Border x:Name="PreviewPanel" Visibility="Collapsed" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="SummaryText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Teal}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <CheckBox x:Name="MarkGstConfiguredCheck" Content="{DynamicResource CatMarkGstConfigured}" FontSize="12.5" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="{DynamicResource Cancel}" Style="{StaticResource SecondaryButton}" MinWidth="100" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ImportButton" Content="{DynamicResource CatConfirmImport}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" MinWidth="180" IsEnabled="False" IsDefault="True" Click="Import_Click" />
        </DockPanel>
    </Grid>
</Window>
