<Window x:Class="Orva.Views.ShopSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:Orva.Controls"
        Title="ORVA — Shop setup" Width="720" Height="700" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource Paper}" FontFamily="{StaticResource UiBodyFont}">
    <Grid fx:OrvaFx.Reveal="Dialog" Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="ORVA" FontFamily="{StaticResource UiHeadingFont}" FontSize="32" Foreground="{StaticResource Teal}" />
            <TextBlock Text="RINDLE WORKS  /  FIRST-TIME SETUP" Style="{StaticResource MetadataText}" Margin="0,5,0,0" />
            <Border Height="3" Background="{StaticResource Vermilion}" Width="72" HorizontalAlignment="Left" Margin="0,16,0,0" />
            <TextBlock Text="Set up this medical shop" Style="{StaticResource DisplayHeading}" FontSize="25" Margin="0,16,0,5" />
            <TextBlock Text="These details appear on your business records and invoices. You can update them later in Settings." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="SHOP NAME *" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ShopNameBox" Margin="0,0,0,14" />

                <TextBlock Text="LEGAL NAME (IF DIFFERENT)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LegalNameBox" Margin="0,0,0,14" />

                <TextBlock Text="SHOP ADDRESS" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AddressBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,14" />

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PHONE" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PhoneBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="EMAIL (OPTIONAL)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="EmailBox" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STATE" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="StateBox" IsEditable="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="STATE CODE" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="StateCodeBox" MaxLength="2" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="GSTIN (IF APPLICABLE)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="GstinBox" CharacterCasing="Upper" MaxLength="15" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DRUG LICENCE NUMBER" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DrugLicenceBox" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,0,0,12" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Your records will remain on this laptop." VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" />
            <Button Content="SAVE SHOP DETAILS" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" IsDefault="True" Click="Save_Click" MinWidth="180" />
        </DockPanel>
    </Grid>
</Window>