<Window x:Class="Orva.Views.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="clr-namespace:Orva.Controls"
        Title="ORVA — Adjust Stock" Width="560" Height="500" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource Paper}" FontFamily="{StaticResource UiBodyFont}">
    <Grid fx:OrvaFx.Reveal="Dialog" Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="INVENTORY  /  STOCK ADJUSTMENT" Style="{StaticResource MetadataText}" />
            <TextBlock Text="{DynamicResource InvAdjustStockTitle}" Style="{StaticResource DisplayHeading}" FontSize="24" Margin="0,4,0,4" />
            <TextBlock x:Name="BatchSummaryText" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
            <Border Height="2" Background="{StaticResource Vermilion}" Width="50" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource PaperRecessed}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource InvCurrentQuantity}" Style="{StaticResource MetadataText}" />
                        <TextBlock x:Name="CurrentQtyText" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource PaperRaised}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource InvDifferenceLabel}" Style="{StaticResource MetadataText}" />
                        <TextBlock x:Name="DifferenceText" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="{DynamicResource InvCountedQuantity}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="CountedQtyBox" Margin="0,0,0,14" TextChanged="CountedQtyBox_TextChanged" />

            <TextBlock Text="{DynamicResource InvAdjustmentReason}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ReasonBox" IsEditable="True" Margin="0,0,0,12">
                <ComboBoxItem Content="Physical stock count correction" />
                <ComboBoxItem Content="Damaged or broken strip" />
                <ComboBoxItem Content="Expired stock write-off" />
                <ComboBoxItem Content="Entry quantity correction" />
            </ComboBox>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="{DynamicResource Cancel}" Style="{StaticResource SecondaryButton}" MinWidth="100" IsCancel="True" Click="Cancel_Click" />
            <Button Content="{DynamicResource InvConfirmAdjustment}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" MinWidth="170" IsDefault="True" Click="Confirm_Click" />
        </DockPanel>
    </Grid>
</Window>
