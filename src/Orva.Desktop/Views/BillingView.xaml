<UserControl x:Class="Orva.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="clr-namespace:Orva.Controls"
             xmlns:controls="clr-namespace:Orva.Controls"
             Background="Transparent"
             FontFamily="{StaticResource UiBodyFont}"
             Loaded="BillingView_Loaded"
             Unloaded="BillingView_Unloaded"
             PreviewKeyDown="BillingView_PreviewKeyDown">

    <UserControl.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:InverseBoolConverter x:Key="InverseBool" />
        <controls:NullToVisibilityConverter x:Key="NullToVisibility" />
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
        <controls:BillingSeverityToBrushConverter x:Key="SeverityToBrush" />

        <!-- Explicit Bengali-capable fallback. The application-level implicit styles set
             the system default font, ensuring bundled UiBodyFont applies consistently. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource UiBodyFont}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource UiBodyFont}" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontFamily" Value="{StaticResource UiBodyFont}" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PaperRaised}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="QuantityBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="MaxLength" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <EventSetter Event="GotFocus" Handler="QuantityBox_GotFocus" />
            <EventSetter Event="PreviewKeyDown" Handler="QuantityBox_PreviewKeyDown" />
            <EventSetter Event="LostFocus" Handler="QuantityBox_LostFocus" />
        </Style>

        <Style x:Key="AmountBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="39" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="MaxLength" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <EventSetter Event="PreviewKeyDown" Handler="AmountBox_PreviewKeyDown" />
            <EventSetter Event="LostFocus" Handler="AmountBox_LostFocus" />
        </Style>

        <Style x:Key="ResultRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Rule}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F1E8D8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource PaperRecessed}" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource Vermilion}" />
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="3,0,0,1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CartRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#E4DAC9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F6F0E5" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#F1E8D8" />
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource Vermilion}" />
                                <Setter TargetName="RowBorder" Property="BorderThickness" Value="3,0,0,1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search result row: name, strength/form, unit + available quantity, availability
             message, and an Add action that is disabled when the backend says CanSell=false. -->
        <DataTemplate x:Key="SearchResultTemplate">
            <Grid Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetailText}"
                               FontSize="11"
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                    <WrapPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding AvailableText}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{StaticResource Vermilion}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanSell}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
                <Button Grid.Column="2"
                        Content="{DynamicResource BillAdd}"
                        Style="{StaticResource SmallButton}"
                        MinWidth="76"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding CanSell}"
                        Command="{Binding DataContext.AddMedicineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Click="AddResult_Click" />
            </Grid>
        </DataTemplate>

        <!-- Cart row: one visible row per medicine. Quantity is editable; the line total is
             written only from InvoicePreviewResult. Batch allocation is never editable. -->
        <DataTemplate x:Key="CartLineTemplate">
            <Grid Margin="0,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="62" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{Binding MedicineName}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AllocationNote}"
                               FontSize="10.5"
                               Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               Visibility="{Binding HasAllocationNote, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBox Style="{StaticResource QuantityBoxStyle}"
                             Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding MedicineName}"
                             ToolTip="{DynamicResource BillColumnQuantity}" />
                    <TextBlock Text="{Binding StockUnitName}"
                               FontSize="10"
                               Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding LineTotalText}"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,9,8,0" />

                <Button Grid.Row="0" Grid.Column="3"
                        Content="{DynamicResource BillRemove}"
                        Style="{StaticResource TinyButton}"
                        VerticalAlignment="Top"
                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="{Binding QuantityError}"
                           Foreground="{StaticResource Danger}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- One tender row. Only the four approved methods are offered. -->
        <DataTemplate x:Key="TenderTemplate">
            <Border Background="#F6F0E5" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding MethodOptions}"
                                  SelectedItem="{Binding SelectedMethod, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  AutomationProperties.Name="{DynamicResource BillPaymentHeading}" />
                        <DockPanel Grid.Column="2" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="₹" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBox Style="{StaticResource AmountBoxStyle}"
                                     Text="{Binding AmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{DynamicResource BillColumnAmount}" />
                        </DockPanel>
                    </Grid>

                    <StackPanel Margin="0,7,0,0" Visibility="{Binding IsNonCash, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource BillReferenceHint}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding ReferenceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12"
                                 MinHeight="36"
                                 Padding="8,6"
                                 MaxLength="80" />
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left"
                                Content="{DynamicResource BillUseRemaining}"
                                Style="{StaticResource TinyButton}"
                                Command="{Binding DataContext.UseRemainingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource BillRemove}"
                                Style="{StaticResource TinyButton}"
                                Command="{Binding DataContext.RemoveTenderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </DockPanel>

                    <TextBlock Text="{Binding AmountError}"
                               Foreground="{StaticResource Danger}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IssueTemplate">
            <TextBlock Text="{Binding Message}"
                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: status message, keyboard hints, live preview toggle. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="{DynamicResource BillPreviewButton}"
                    Style="{StaticResource SmallButton}"
                    MinWidth="150"
                    VerticalAlignment="Center"
                    Click="PreviewToggle_Click" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12.5"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{DynamicResource BillKeyboardHint}" Style="{StaticResource MetadataText}" FontSize="9.5" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: search + cart -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14"
                        IsEnabled="{Binding CanEditDraft}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource BillSearchLabel}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" fx:OrvaFx.BarcodePulse="True"
                                 FontSize="16"
                                 MinHeight="46"
                                 MaxLength="120"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{DynamicResource BillSearchLabel}"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <TextBlock Text="{DynamicResource BillSearchHint}"
                                   FontSize="11"
                                   Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <!-- Cart card. The results overlay below shares this row so that opening the
                     result list never reflows or squeezes the cart at 1000x640. -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" MinHeight="140">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="14,12,14,10" LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="{DynamicResource BillClear}"
                                    Style="{StaticResource TinyButton}"
                                    MinWidth="86"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding CanClearBill}"
                                    Click="ClearBill_Click" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource BillCartHeading}" Style="{StaticResource SectionHeading}" FontSize="15" />
                                <TextBlock Text="{Binding CartCountText}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Column headers. Right offset = item padding (10) + the always-present
                             vertical scrollbar (17), so headers stay aligned with the rows. -->
                        <Grid Grid.Row="1" Margin="10,0,27,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="62" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource BillColumnMedicine}" Style="{StaticResource MetadataText}" FontSize="9.5" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource BillColumnQuantity}" Style="{StaticResource MetadataText}" FontSize="9.5" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource BillColumnAmount}" Style="{StaticResource MetadataText}" FontSize="9.5" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        </Grid>
                        <Border Grid.Row="1" Height="1" Background="{StaticResource Rule}" VerticalAlignment="Bottom" Margin="10,0,10,0" />

                        <Grid Grid.Row="2">
                            <ListBox x:Name="CartList" fx:OrvaFx.FlashOnAdd="True"
                                     ItemsSource="{Binding CartLines}"
                                     SelectedItem="{Binding SelectedCartLine, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource CartLineTemplate}"
                                     ItemContainerStyle="{StaticResource CartRowStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Margin="0,0,0,6"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     IsEnabled="{Binding CanEditDraft}"
                                     AutomationProperties.Name="{DynamicResource BillCartHeading}" />
                            <TextBlock Text="{DynamicResource BillCartEmpty}"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       MaxWidth="260"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Search results overlay. It is shown only for the query that produced it;
                     the view model clears both the list and the selection on every keystroke. -->
                <Border Grid.Row="2"
                        Panel.ZIndex="10"
                        VerticalAlignment="Top"
                        Style="{StaticResource CardBorder}"
                        Padding="0"
                        Visibility="{Binding ShowSearchOverlay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="12,10,12,6" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{DynamicResource BillSearchBusy}"
                                       FontSize="11"
                                       Foreground="{StaticResource Vermilion}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{DynamicResource BillSearchResultsLabel}" Style="{StaticResource MetadataText}" FontSize="9.5" VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource Rule}" />
                        <ListBox x:Name="ResultsList"
                                 ItemsSource="{Binding SearchResults}"
                                 SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource SearchResultTemplate}"
                                 ItemContainerStyle="{StaticResource ResultRowStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="260"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                 Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibility}}"
                                 PreviewKeyDown="ResultsList_PreviewKeyDown"
                                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                                 AutomationProperties.Name="{DynamicResource BillSearchResultsLabel}" />
                        <TextBlock Text="{DynamicResource BillStatusNotFound}"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="12.5"
                                   Margin="12,12,12,14"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowNoSearchResults, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT: success panel, summary, payments, customer, issues, generate -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14,16,16">
                    <StackPanel>

                        <!-- Committed invoice panel. Appears only after database commit with a
                             lightweight, non-blocking stamp transition and true scalloped vermilion ticket edge. -->
                        <StackPanel Margin="0,0,0,16" fx:OrvaFx.Reveal="Rise" Visibility="{Binding IsCommitted, Converter={StaticResource BoolToVisibility}}">
                            <!-- Signature scalloped vermilion ticket edge: vermilion underlay visible behind semicircular die-cut paper scallops -->
                            <Border Height="12" Background="{StaticResource Vermilion}" ClipToBounds="True">
                                <Border.OpacityMask>
                                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,12" ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="Black">
                                                <GeometryDrawing.Geometry>
                                                    <PathGeometry Figures="M 0,0 L 16,0 L 16,12 A 6,6 0 0 0 4,12 L 0,12 Z" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.OpacityMask>
                                <Rectangle Height="12" Fill="{StaticResource Vermilion}" />
                            </Border>
                                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                                <fx:RegistrationMark VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Border fx:OrvaFx.Reveal="Stamp"
                                        Background="{StaticResource PaperRaised}"
                                        BorderBrush="{StaticResource Vermilion}"
                                        BorderThickness="1.5"
                                        Padding="12,6"
                                        HorizontalAlignment="Left">
                                    <Border BorderBrush="{StaticResource Vermilion}" BorderThickness="0.75" Padding="8,3">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource BillSuccessStamp}"
                                                       FontFamily="{StaticResource UiMonoFont}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource FederalBlue}" Opacity="0.28"
                                                       Margin="2.2,1.8,0,0" />
                                            <TextBlock Text="{DynamicResource BillSuccessStamp}"
                                                       FontFamily="{StaticResource UiMonoFont}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource Teal}" Opacity="0.32"
                                                       Margin="1.1,0.9,0,0" />
                                            <TextBlock Text="{DynamicResource BillSuccessStamp}"
                                                       FontFamily="{StaticResource UiMonoFont}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource Vermilion}" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <fx:RegistrationMark VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource BillSuccessEyebrow}" FontFamily="{StaticResource UiMonoFont}" FontSize="10" Foreground="{StaticResource Vermilion}" Margin="0,10,0,0" />
                            <TextBlock Text="{Binding LastInvoiceNumber}" FontFamily="{StaticResource UiHeadingFont}" FontSize="23" Foreground="{StaticResource Teal}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding LastInvoiceIssuedText}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding LastInvoiceTotalText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Teal}" Margin="0,6,0,0" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="NewBillButton" Grid.Column="0"
                                        Content="{DynamicResource BillNewBill}"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding NewBillCommand}"
                                        Click="NewBill_Click" />
                                <Button Grid.Column="2"
                                        Content="{DynamicResource BillPrint}"
                                        Style="{StaticResource SmallButton}"
                                        MinWidth="90"
                                        Click="Print_Click" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource Rule}" Margin="0,16,0,0" />
                        </StackPanel>

                        <TextBlock Text="{DynamicResource BillSummaryHeading}" Style="{StaticResource SectionHeading}" FontSize="15" />

                        <!-- Staleness indicator: shown from the instant the draft changes until
                             the matching preview response is applied. -->
                        <TextBlock Text="{DynamicResource BillUpdatingTotals}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Vermilion}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding IsPreviewPending, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewPending}" Value="True">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <DockPanel Margin="0,0,0,5" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalText}" Style="{StaticResource SummaryValue}" />
                                <TextBlock Text="{DynamicResource BillSubtotal}" Style="{StaticResource SummaryLabel}" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,5" LastChildFill="True" Visibility="{Binding ShowCgstSgst, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CgstText}" Style="{StaticResource SummaryValue}" />
                                <TextBlock Text="{DynamicResource BillCgst}" Style="{StaticResource SummaryLabel}" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,5" LastChildFill="True" Visibility="{Binding ShowCgstSgst, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SgstText}" Style="{StaticResource SummaryValue}" />
                                <TextBlock Text="{DynamicResource BillSgst}" Style="{StaticResource SummaryLabel}" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,5" LastChildFill="True" Visibility="{Binding ShowIgst, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding IgstText}" Style="{StaticResource SummaryValue}" />
                                <TextBlock Text="{DynamicResource BillIgst}" Style="{StaticResource SummaryLabel}" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,5" LastChildFill="True" Visibility="{Binding ShowRoundOff, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RoundOffText}" Style="{StaticResource SummaryValue}" />
                                <TextBlock Text="{DynamicResource BillRoundOff}" Style="{StaticResource SummaryLabel}" />
                            </DockPanel>

                            <Border Height="1" Background="{StaticResource Rule}" Margin="0,6,0,8" />

                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding GrandTotalText}" fx:OrvaFx.ValuePulse="True" FontFamily="{StaticResource UiHeadingFont}" FontSize="22" Foreground="{StaticResource Teal}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource BillGrandTotal}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Teal}" VerticalAlignment="Center" />
                            </DockPanel>

                            <Border Height="1" Background="{StaticResource Rule}" Margin="0,8,0,8" />

                            <DockPanel Margin="0,0,0,5" LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TenderedText}" Style="{StaticResource SummaryValue}" />
                                <TextBlock Text="{DynamicResource BillTendered}" Style="{StaticResource SummaryLabel}" />
                            </DockPanel>

                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground" Value="{StaticResource Vermilion}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFullyPaid}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource BillRemaining}" Style="{StaticResource SummaryLabel}" />
                            </DockPanel>

                            <TextBlock Text="{DynamicResource BillExactPaid}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Success}"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding IsFullyPaid, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{DynamicResource BillOverpaid}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource Vermilion}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding IsOverTendered, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Rule}" Margin="0,14,0,12" />

                        <!-- Payments -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right"
                                    Content="{DynamicResource BillAddPayment}"
                                    Style="{StaticResource TinyButton}"
                                    MinWidth="110"
                                    VerticalAlignment="Center"
                                    Command="{Binding AddTenderCommand}"
                                    IsEnabled="{Binding CanEditDraft}" />
                            <TextBlock Text="{DynamicResource BillPaymentHeading}" Style="{StaticResource SectionHeading}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                        </DockPanel>

                        <TextBlock Text="{DynamicResource BillPaymentEmpty}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasTenders, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Exact Cash (F8)" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5" Margin="0,0,6,4" IsEnabled="{Binding CanEditDraft}" Click="ExactCash_Click" />
                                <Button Content="Exact UPI (F9)" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11.5" Margin="0,0,0,4" IsEnabled="{Binding CanEditDraft}" Click="ExactUpi_Click" />
                            </WrapPanel>
                            <ItemsControl ItemsSource="{Binding Tenders}"
                                      ItemTemplate="{StaticResource TenderTemplate}"
                                      IsEnabled="{Binding CanEditDraft}" />

                        <!-- Optional customer details, collapsed by default. -->
                        <Expander Header="{DynamicResource BillCustomerHeading}"
                                  IsExpanded="{Binding IsCustomerExpanded, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditDraft}"
                                  Foreground="{StaticResource Teal}"
                                  FontWeight="SemiBold"
                                  FontSize="12.5"
                                  Margin="0,4,0,0">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource BillCustomerName}" Style="{StaticResource FieldLabel}" />
                                <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Vermilion}" BorderThickness="1" Padding="8,6" Margin="0,0,0,8" Visibility="{Binding ShowHighValueB2cReminder, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Invoice is ₹ 50,000 or more — enter Customer Name &amp; Address per GST Rule 46." FontSize="11.5" Foreground="{StaticResource Vermilion}" TextWrapping="Wrap" />
                            </Border>
                            <TextBox Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,0,0,9" />
                                <TextBlock Text="{DynamicResource BillCustomerPhone}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,0,0,9" />
                                <TextBlock Text="{DynamicResource BillCustomerAddress}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CustomerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="240" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" VerticalContentAlignment="Top" Margin="0,0,0,9" />
                                <TextBlock Text="{DynamicResource BillCustomerGstin}" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding CustomerGstin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" CharacterCasing="Upper" />
                            </StackPanel>
                        </Expander>

                        <!-- Backend issues, including missing tax configuration. -->
                        <Border Background="#F6F0E5" BorderBrush="{StaticResource Rule}" BorderThickness="1" CornerRadius="5" Padding="11" Margin="0,14,0,0"
                                Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource BillIssuesHeading}" Style="{StaticResource MetadataText}" FontSize="9.5" Margin="0,0,0,7" />
                                <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueTemplate}" />
                            </StackPanel>
                        </Border>

                        <Button Margin="0,16,0,0"
                                MinHeight="52"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding FinalizeCommand}"
                                IsEnabled="{Binding GenerateEnabled}"
                                AutomationProperties.Name="{DynamicResource BillGenerate}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="{DynamicResource BillGenerate}" />
                                        <Setter Property="Foreground" Value="{StaticResource Paper}" />
                                        <Setter Property="FontSize" Value="15" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Text" Value="{DynamicResource BillGenerating}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>